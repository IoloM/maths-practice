  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen": "tsx scripts/gen-index.ts",
    "bank": "tsx scripts/gen-index.ts && tsx scripts/build-bank.ts",
    "bank:check": "tsx scripts/build-bank.ts --check",
    "coverage": "tsx scripts/coverage.ts",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "icons": "pwa-assets-generator",
    "build:cloud-test": "VITE_SUPABASE_URL=https://supa.test VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test vite build --outDir dist-cloud"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.141.0",
    "@supabase/supabase-js": "^2.117.2",
    "idb": "^8.0.3",
    "katex": "^0.18.10",
    "mathlive": "^0.111.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "lighthouse": "^13.5.0",
    "supabase": "^2.119.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
